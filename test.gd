extends Node2D

@onready var hand_pointer: ColorRect = $HandPointer
@onready var pinch_indicator: ColorRect = $PinchIndicator
@onready var status_label: Label = $UI/StatusLabel

@export var keyboard_speed: float = 400.0
var virtual_input := Vector2.ZERO

func _ready() -> void:
	if Engine.has_singleton("VisionBridge") or get_node_or_null("/root/VisionBridge"):
		VisionBridge.connect("landmark_updated", _on_landmark_updated)
		VisionBridge.connect("hand_detected", _on_hand_detected)
		status_label.text = "VisionBridge Connected. Camera Active."
	else:
		status_label.text = "Error: VisionBridge Autoload not found!"

func _process(delta: float) -> void:
	var input_dir = Vector2.ZERO
	
	# 1. Hardware Keyboard Support
	if Input.is_key_pressed(KEY_W): input_dir.y -= 1
	if Input.is_key_pressed(KEY_S): input_dir.y += 1
	if Input.is_key_pressed(KEY_A): input_dir.x -= 1
	if Input.is_key_pressed(KEY_D): input_dir.x += 1
	
	# 2. Virtual Camera Joystick Support
	if virtual_input.y < -0.5: input_dir.y -= 1
	if virtual_input.y > 0.5: input_dir.y += 1
	if virtual_input.x < -0.5: input_dir.x -= 1
	if virtual_input.x > 0.5: input_dir.x += 1

	# Move the square exclusively via velocity 
	if input_dir != Vector2.ZERO:
		input_dir = input_dir.normalized()
		hand_pointer.position += input_dir * keyboard_speed * delta
		
		var viewport_size = get_viewport_rect().size
		hand_pointer.position.x = clamp(hand_pointer.position.x, 0, viewport_size.x - hand_pointer.size.x)
		hand_pointer.position.y = clamp(hand_pointer.position.y, 0, viewport_size.y - hand_pointer.size.y)

func _on_landmark_updated(_hand_id: int, landmarks: Array) -> void:
	if landmarks.size() > 0:
		# Extract the simulated WASD vector generated by Python
		virtual_input.x = landmarks[0]["x"]
		virtual_input.y = landmarks[0]["y"]

func _on_hand_detected(_hand_id: int, handedness: String, is_pinching: bool) -> void:
	if is_pinching:
		pinch_indicator.color = Color.RED
		status_label.text = "Hand: %s | State: WASD HELD" % handedness
	else:
		pinch_indicator.color = Color.DARK_GRAY
		status_label.text = "Hand: %s | Pinch to drive" % handedness
